# Docker Compose runtime profile. Production is the safe default.
QUARKUS_PROFILE=prod

# Public browser URLs. These must be reachable from the user's browser.
VITE_API_URL=https://inventory-api.example.com
VITE_OIDC_AUTHORITY=https://auth.example.com/application/o/inventory/
VITE_OIDC_REDIRECT_URI=https://inventory.example.com/
VITE_OIDC_SCOPE=openid profile email offline_access

# The React SPA cannot keep a secret. Configure this Client ID on the Authentik
# OAuth2/OIDC provider with Client type "Public" and an exact redirect URI match.
# Quarkus validates the bearer tokens issued to the same client.
OIDC_CLIENT_ID=inventory
OIDC_ENABLED=true
OIDC_AUTH_SERVER_URL=https://auth.example.com/application/o/inventory/
BACKEND_OIDC_CLIENT_SECRET=
# Must stay false in the prod profile; the API refuses to start otherwise.
DEV_AUTH_ENABLED=false
# Pre-launch only: administrators may act as any account (works with OIDC, also in prod). Removed before go-live.
# Each impersonated request is logged; outbox events keep the administrator in impersonator_id.
IMPERSONATION_ENABLED=false
VITE_IMPERSONATION=false
# Optional: check every access token at Authentik's introspection endpoint (needs
# BACKEND_OIDC_CLIENT_SECRET). Otherwise keep the Authentik access-token lifetime short
# (<= 5 minutes); that lifetime bounds how long a revoked token is accepted.
OIDC_REQUIRE_INTROSPECTION=false

# Advanced only: distinct clients require an Authentik audience mapping so the
# frontend token is accepted by the API.
# VITE_OIDC_CLIENT_ID=inventory-app
# BACKEND_OIDC_CLIENT_ID=inventory-api

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=https://inventory.example.com

# Bind direct container ports to loopback by default. A host reverse proxy can
# publish them; override only when direct LAN/WAN access is intentional.
API_BIND_ADDRESS=127.0.0.1
APP_BIND_ADDRESS=127.0.0.1

# Enable forwarding only behind a proxy, and trust only that proxy's IP/CIDR.
PROXY_ADDRESS_FORWARDING=true
PROXY_ALLOW_FORWARDED=true
PROXY_ALLOW_X_FORWARDED=false
# Replace this with the reverse proxy source address as seen by the container.
TRUSTED_PROXIES=172.17.0.1

# Business time zone for due dates, availability windows and report dates.
INVENTORY_TIMEZONE=Europe/Berlin

# Authentik group that grants access to the inventory system. Roles and factions are set in the app (Users page).
INVENTORY_ACCESS_GROUP=inventory
# Bootstrap admin e-mail addresses (comma-separated), matched against the access token's email claim.
INVENTORY_BOOTSTRAP_ADMINS=

# Database and optional integrations. DB_PASSWORD is required and has no default:
# generate a unique value (openssl rand -hex 32); compose refuses to start while it is missing or empty.
DB_PASSWORD=
MEDIA_MODE=local

# OpenTelemetry traces, metrics and correlated debug logs to OpenObserve. See docs/TECHNICAL_REQUIREMENTS.md §7 (Observability).
# Organization base URL; Quarkus appends /v1/traces, /v1/metrics and /v1/logs.
# The token is base64("email:password") from OpenObserve's Ingestion page.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default
OTEL_EXPORTER_OTLP_TOKEN=
OTEL_LOG_LEVEL=WARN
# INFO in production; set DEBUG for opt-in diagnostics.
INVENTORY_LOG_LEVEL=INFO
OTEL_LOGS_LEVEL=INFO
OTEL_LOG_STREAM=inventory_backend
OTEL_METRIC_EXPORT_INTERVAL=15s
OTEL_OUTBOX_SNAPSHOT_EVERY=30s
DEPLOYMENT_ENVIRONMENT=production
# Set APP_VERSION to the deployed release or Git commit. Used by backend and frontend.
APP_VERSION=dev
# Optional: empty generates a new UUID per backend process. Cluster IDs must differ.
OTEL_SERVICE_INSTANCE_ID=
OTEL_SERVICE_INSTANCE_ID_1=
OTEL_SERVICE_INSTANCE_ID_2=

# docker-compose.yml runs one API node with in-process events and rate limiting.
# docker-compose.cluster.yml adds Valkey for cross-node events and rate limiting.
API_RATE_LIMIT_REQUESTS=300
API_RATE_LIMIT_WINDOW_SECONDS=60

# Logical PostgreSQL replication to the storage VPS. Bind the primary only to
# a private VPN/LAN address, never directly to the public web.
DB_REPLICATION_BIND_ADDRESS=127.0.0.1
DB_REPLICATION_PORT=5432
POSTGRES_MAX_SLOT_WAL_KEEP_SIZE=10GB

# docker-compose.cluster.yml only. On VPS 1, bind Valkey to the private address
# the second API node uses (it has no password). On VPS 2, point at VPS 1 instead
# of the local Compose services; see docs/DEPLOYMENT_STEP2.md.
VALKEY_BIND_ADDRESS=127.0.0.1
# DB_URL=jdbc:postgresql://10.0.0.10:5432/inventory
# REDIS_URL=redis://10.0.0.10:6379
# S3_ENDPOINT=https://s3.example.com

# Garage (docker-compose.garage.yml, docker-compose.cluster.yml, docker-compose.storage.yml).
# Compose refuses to start Garage without these; never reuse the example values.
# GARAGE_RPC_SECRET=<openssl rand -hex 32>
# GARAGE_ADMIN_TOKEN=<openssl rand -hex 32>
# Garage WebUI login as user:bcrypt-hash (htpasswd -nbBC 10 admin <password>); escape $ as $$.
# GARAGE_WEBUI_AUTH=
# Admin API (3903) and WebUI (3909) bind to loopback; reach them through an SSH tunnel.
GARAGE_ADMIN_BIND_ADDRESS=127.0.0.1
GARAGE_WEBUI_BIND_ADDRESS=127.0.0.1
# docker-compose.storage.yml monitoring agent credentials from the Beszel hub.
# BESZEL_AGENT_KEY=
# BESZEL_AGENT_TOKEN=

# PostgreSQL instance created by docker-compose.storage.yml on the storage VPS.
REPLICA_DB_PASSWORD=change-replica-database-password
REPLICA_DB_BIND_ADDRESS=127.0.0.1
REPLICA_DB_PORT=5433

# Local Docker development without an OIDC provider:
# QUARKUS_PROFILE=dev
# OIDC_ENABLED=false
# DEV_AUTH_ENABLED=true
# VITE_API_URL=http://localhost:8080
# VITE_OIDC_REDIRECT_URI=http://localhost:3333/
# VITE_OIDC_AUTHORITY=
# VITE_OIDC_CLIENT_ID=
# VITE_DEV_LOGIN=true
# CORS_ORIGINS=http://localhost:5173,http://localhost:3333

# Optional external notification gateway (HTTPS, deduplicates Idempotency-Key).
INVENTORY_NOTIFICATION_WEBHOOK_URL=
INVENTORY_NOTIFICATION_WEBHOOK_TOKEN=
# Bundled ntfy is configured entirely through Compose environment variables (docs/NTFY.md).
# Bind to loopback for a host reverse proxy; use a shared network for a container reverse proxy.
NTFY_BIND_ADDRESS=127.0.0.1
NTFY_PORT=8090
# Required bcrypt hash for ntfy's inventory account. Single-quote the value in .env to preserve '$'.
# Generate with: docker run --rm -it binwiederhier/ntfy:v2.34.0 user hash
NTFY_PASSWORD_HASH=
# Users choose their personal topic on the profile page.
# NTFY_URL is where the API publishes: HTTPS, or plain HTTP to an ntfy container on the internal network
# (e.g. http://ntfy; HTTP to a public address is refused). NTFY_PUBLIC_URL is the subscribe address shown to users and ntfy's base URL.
# Required token shared by the API and ntfy. Generate with: docker run --rm binwiederhier/ntfy:v2.34.0 token generate
INVENTORY_NOTIFICATION_NTFY_URL=http://ntfy
# Public HTTPS subscription URL for deployment; also sets ntfy's NTFY_BASE_URL.
INVENTORY_NOTIFICATION_NTFY_PUBLIC_URL=http://localhost:8090
INVENTORY_NOTIFICATION_NTFY_TOKEN=
INVENTORY_NOTIFICATION_NTFY_USERNAME=
INVENTORY_NOTIFICATION_NTFY_PASSWORD=
# Admin topics ("none" disables one). Item/assembly actions: created,updated,deleted or none.
# On public servers anyone can read a topic: pick unguessable names or restrict them with ntfy ACLs.
INVENTORY_NOTIFICATION_NTFY_ITEMS_TOPIC=inventory-items
INVENTORY_NOTIFICATION_NTFY_ITEMS_ACTIONS=created,deleted
INVENTORY_NOTIFICATION_NTFY_ASSEMBLIES_TOPIC=inventory-assemblies
INVENTORY_NOTIFICATION_NTFY_ASSEMBLIES_ACTIONS=created,deleted
INVENTORY_NOTIFICATION_NTFY_USERS_TOPIC=inventory-users
INVENTORY_NOTIFICATION_NTFY_TOPICS_INTERVAL=60s
# Public address of the app: every notification link (ntfy, webhooks, mail) starts with it. Set your real domain in production.
INVENTORY_PUBLIC_URL=http://localhost:5173

# Process roles: all (single-node default), api, worker. Comma-separated jobs or all.
INVENTORY_PROCESS_ROLE=all
INVENTORY_WORKER_JOBS=all
# Report source and generation row budgets; oversized jobs fail without replacing the last good report.
REPORT_MAX_SOURCE_ROWS=25000
REPORT_MAX_OUTPUT_ROWS=25000
# Cluster pools: total connections = sum(replicas * pool size) plus operator/replication headroom.
WORKER_DB_POOL_SIZE=3
NOTIFICATION_DB_POOL_SIZE=2
REPORT_DB_POOL_SIZE=2
