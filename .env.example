# Docker Compose runtime profile. Production is the safe default.
QUARKUS_PROFILE=prod

# Public browser URLs. These must be reachable from the user's browser.
VITE_API_URL=https://inventory-api.example.com
VITE_OIDC_AUTHORITY=https://auth.example.com/application/o/inventory/
VITE_OIDC_REDIRECT_URI=https://inventory.example.com/
VITE_OIDC_SCOPE=openid profile email offline_access

# The React SPA cannot keep a secret. Configure this Client ID on the Authentik
# OAuth2/OIDC provider with Client type "Public" and an exact redirect URI match.
# Quarkus validates the bearer tokens issued to the same client.
OIDC_CLIENT_ID=inventory
OIDC_ENABLED=true
OIDC_AUTH_SERVER_URL=https://auth.example.com/application/o/inventory/
BACKEND_OIDC_CLIENT_SECRET=
DEV_AUTH_ENABLED=false

# Advanced only: distinct clients require an Authentik audience mapping so the
# frontend token is accepted by the API.
# VITE_OIDC_CLIENT_ID=inventory-app
# BACKEND_OIDC_CLIENT_ID=inventory-api

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=https://inventory.example.com

# Bind direct container ports to loopback by default. A host reverse proxy can
# publish them; override only when direct LAN/WAN access is intentional.
API_BIND_ADDRESS=127.0.0.1
APP_BIND_ADDRESS=127.0.0.1

# Enable forwarding only behind a proxy, and trust only that proxy's IP/CIDR.
PROXY_ADDRESS_FORWARDING=true
PROXY_ALLOW_FORWARDED=true
PROXY_ALLOW_X_FORWARDED=false
# Replace this with the reverse proxy source address as seen by the container.
TRUSTED_PROXIES=172.17.0.1

# Database and optional integrations.
DB_PASSWORD=change-me
OTEL_ENABLED=false
MEDIA_MODE=local

# Shared Valkey is enabled by docker-compose.yml for catalog caching, rate
# limiting, and live-event fan-out. It is intentionally not published publicly.
API_RATE_LIMIT_REQUESTS=300
API_RATE_LIMIT_WINDOW_SECONDS=60

# Physical PostgreSQL streaming replication to the storage VPS. Bind the
# primary only to a private VPN/LAN address, never directly to the public web.
DB_REPLICATION_BIND_ADDRESS=127.0.0.1
DB_REPLICATION_PORT=5432
REPLICATION_USER=inventory_replicator
REPLICATION_PASSWORD=change-replication-password
REPLICATION_SLOT=inventory_storage_standby
REPLICATION_CIDR=10.0.0.0/24
POSTGRES_WAL_KEEP_SIZE=1GB
POSTGRES_MAX_SLOT_WAL_KEEP_SIZE=10GB

# These values are used by docker-compose.storage.yml on the storage VPS.
PRIMARY_DB_HOST=10.0.0.10
PRIMARY_DB_PORT=5432
PRIMARY_DB_SSLMODE=prefer
STANDBY_DB_BIND_ADDRESS=127.0.0.1
STANDBY_DB_PORT=5433

# Local Docker development without an OIDC provider:
# QUARKUS_PROFILE=dev
# OIDC_ENABLED=false
# DEV_AUTH_ENABLED=true
# VITE_API_URL=http://localhost:8080
# VITE_OIDC_REDIRECT_URI=http://localhost:3333/
# VITE_OIDC_AUTHORITY=
# VITE_OIDC_CLIENT_ID=
# CORS_ORIGINS=http://localhost:5173,http://localhost:3333
