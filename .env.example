# Docker Compose runtime profile. Production is the safe default.
QUARKUS_PROFILE=prod

# Public browser URLs. These must be reachable from the user's browser.
VITE_API_URL=https://inventory-api.example.com
VITE_OIDC_AUTHORITY=https://auth.example.com/application/o/inventory/
VITE_OIDC_REDIRECT_URI=https://inventory.example.com/
VITE_OIDC_SCOPE=openid profile email offline_access

# The React SPA cannot keep a secret. Configure this Client ID on the Authentik
# OAuth2/OIDC provider with Client type "Public" and an exact redirect URI match.
# Quarkus validates the bearer tokens issued to the same client.
OIDC_CLIENT_ID=inventory
OIDC_ENABLED=true
OIDC_AUTH_SERVER_URL=https://auth.example.com/application/o/inventory/
BACKEND_OIDC_CLIENT_SECRET=
# Must stay false in the prod profile; the API refuses to start otherwise.
DEV_AUTH_ENABLED=false
# Optional: check every access token at Authentik's introspection endpoint (needs
# BACKEND_OIDC_CLIENT_SECRET). Otherwise keep the Authentik access-token lifetime short
# (<= 5 minutes); that lifetime bounds how long a revoked token is accepted.
OIDC_REQUIRE_INTROSPECTION=false

# Advanced only: distinct clients require an Authentik audience mapping so the
# frontend token is accepted by the API.
# VITE_OIDC_CLIENT_ID=inventory-app
# BACKEND_OIDC_CLIENT_ID=inventory-api

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=https://inventory.example.com

# Bind direct container ports to loopback by default. A host reverse proxy can
# publish them; override only when direct LAN/WAN access is intentional.
API_BIND_ADDRESS=127.0.0.1
APP_BIND_ADDRESS=127.0.0.1

# Enable forwarding only behind a proxy, and trust only that proxy's IP/CIDR.
PROXY_ADDRESS_FORWARDING=true
PROXY_ALLOW_FORWARDED=true
PROXY_ALLOW_X_FORWARDED=false
# Replace this with the reverse proxy source address as seen by the container.
TRUSTED_PROXIES=172.17.0.1

# Business time zone for due dates, availability windows and report dates.
INVENTORY_TIMEZONE=Europe/Berlin

# Authentik group that grants access to the inventory system. Roles and factions are set in the app (Users page).
INVENTORY_ACCESS_GROUP=inventory
# E-mails or usernames (comma-separated) that become inventory admin on first sign-in, or while no admin exists.
INVENTORY_BOOTSTRAP_ADMINS=

# Database and optional integrations.
DB_PASSWORD=change-me
MEDIA_MODE=local

# OpenTelemetry traces, metrics and correlated debug logs to OpenObserve. See docs/TECHNICAL_REQUIREMENTS.md §7 (Observability).
# Organization base URL; Quarkus appends /v1/traces, /v1/metrics and /v1/logs.
# The token is base64("email:password") from OpenObserve's Ingestion page.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default
OTEL_EXPORTER_OTLP_TOKEN=
OTEL_LOG_LEVEL=WARN
INVENTORY_LOG_LEVEL=DEBUG
OTEL_LOGS_LEVEL=DEBUG
OTEL_LOG_STREAM=inventory_backend
OTEL_METRIC_EXPORT_INTERVAL=15s
OTEL_OUTBOX_SNAPSHOT_EVERY=30s
DEPLOYMENT_ENVIRONMENT=production
# Set APP_VERSION to the deployed release or Git commit. Used by backend and frontend.
APP_VERSION=dev
# Optional: empty generates a new UUID per backend process. Cluster IDs must differ.
OTEL_SERVICE_INSTANCE_ID=
OTEL_SERVICE_INSTANCE_ID_1=
OTEL_SERVICE_INSTANCE_ID_2=

# docker-compose.yml runs one API node with in-process events and rate limiting.
# docker-compose.cluster.yml adds Valkey for cross-node events and rate limiting.
API_RATE_LIMIT_REQUESTS=300
API_RATE_LIMIT_WINDOW_SECONDS=60

# Logical PostgreSQL replication to the storage VPS. Bind the primary only to
# a private VPN/LAN address, never directly to the public web.
DB_REPLICATION_BIND_ADDRESS=127.0.0.1
DB_REPLICATION_PORT=5432
POSTGRES_MAX_SLOT_WAL_KEEP_SIZE=10GB

# docker-compose.cluster.yml only. On VPS 1, bind Valkey to the private address
# the second API node uses (it has no password). On VPS 2, point at VPS 1 instead
# of the local Compose services; see docs/DEPLOYMENT_STEP2.md.
VALKEY_BIND_ADDRESS=127.0.0.1
# DB_URL=jdbc:postgresql://10.0.0.10:5432/inventory
# REDIS_URL=redis://10.0.0.10:6379
# S3_ENDPOINT=https://s3.example.com

# PostgreSQL instance created by docker-compose.storage.yml on the storage VPS.
REPLICA_DB_PASSWORD=change-replica-database-password
REPLICA_DB_BIND_ADDRESS=127.0.0.1
REPLICA_DB_PORT=5433

# Local Docker development without an OIDC provider:
# QUARKUS_PROFILE=dev
# OIDC_ENABLED=false
# DEV_AUTH_ENABLED=true
# VITE_API_URL=http://localhost:8080
# VITE_OIDC_REDIRECT_URI=http://localhost:3333/
# VITE_OIDC_AUTHORITY=
# VITE_OIDC_CLIENT_ID=
# VITE_DEV_LOGIN=true
# CORS_ORIGINS=http://localhost:5173,http://localhost:3333
