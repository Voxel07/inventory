[
  {
    "name": "Inventory API readiness",
    "description": "api_ready < 1; see docs/OPERATIONS_RUNBOOK.md",
    "enabled": true,
    "is_real_time": false,
    "stream_type": "logs",
    "stream_name": "inventory_ops",
    "query_condition": {
      "type": "sql",
      "sql": "select host, max(value) as value from inventory_ops where signal = 'api_ready' group by host having max(value) < 1"
    },
    "trigger_condition": {
      "period": 3,
      "frequency": 1,
      "frequency_type": "minutes",
      "operator": ">=",
      "threshold": 1,
      "silence": 15
    },
    "destinations": [
      "inventory-operations"
    ],
    "notify_on_recovery": true
  },
