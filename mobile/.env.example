# Use an HTTPS API URL reachable by phones and desktop browsers.
# For a physical device, localhost refers to the device, not your computer.
EXPO_PUBLIC_API_URL=https://inventory-api.example.com

# Leave both empty only when the backend enables development login.
EXPO_PUBLIC_OIDC_AUTHORITY=https://auth.example.com/application/o/inventory/
EXPO_PUBLIC_OIDC_CLIENT_ID=inventory
